<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/dialog_calendar_import_mapping_source_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            app:srcCompat="@drawable/ic_google_calendar"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="@+id/dialog_calendar_import_mapping_source_title"
            app:layout_constraintBottom_toBottomOf="@+id/dialog_calendar_import_mapping_source_title"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/dialog_calendar_import_mapping_source_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="General"
            style="@style/Text.Default"
            android:layout_marginStart="60dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/spacing_page"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/dialog_calendar_import_mapping_source_separator"
            style="@style/Separator"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_import_mapping_source_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <include
            android:id="@+id/dialog_calendar_import_mapping_new_calendar_press"
            layout="@layout/view_press_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_import_mapping_source_separator"
            app:layout_constraintBottom_toTopOf="@+id/dialog_calendar_import_mapping_new_calendar_separator"/>

        <TextView
            android:id="@+id/dialog_calendar_import_mapping_new_calendar_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/import_assistant_new_calendar_header"
            style="@style/Proton.Text.DefaultSmall.Weak"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="@dimen/spacing_page"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_import_mapping_source_separator"/>

        <ImageView
            android:id="@+id/dialog_calendar_import_mapping_new_calendar_icon"
            app:srcCompat="@drawable/ic_dot"
            tools:tint="@color/purple_base"
            android:layout_marginStart="19dp"
            style="@style/ColoredDot"
            app:layout_constraintTop_toTopOf="@+id/dialog_calendar_import_mapping_new_calendar_title"
            app:layout_constraintBottom_toBottomOf="@+id/dialog_calendar_import_mapping_new_calendar_title"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/dialog_calendar_import_mapping_new_calendar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="General"
            style="@style/Text.Default"
            android:layout_marginStart="60dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/spacing_page"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_import_mapping_new_calendar_header"/>

        <View
            android:id="@+id/dialog_calendar_import_mapping_new_calendar_separator"
            style="@style/Separator"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_import_mapping_new_calendar_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dialog_calendar_import_mapping_merge_layout"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_import_mapping_new_calendar_separator"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include
                android:id="@+id/dialog_calendar_import_mapping_merge_press"
                layout="@layout/view_press_overlay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/dialog_calendar_import_mapping_merge_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/import_assistant_merge_calendar_header"
                style="@style/Proton.Text.DefaultSmall.Weak"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="@dimen/spacing_page"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dialog_calendar_import_mapping_merge_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_import_mapping_merge_header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/item_calendar_import_mapping"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
