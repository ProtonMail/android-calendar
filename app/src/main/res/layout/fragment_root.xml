<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/root_splash_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/logo_calendar_light"
        android:visibility="invisible"
        tools:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ProgressBar
        android:id="@+id/root_progress_bar"
        android:layout_width="@dimen/attendee_avatar_size"
        android:layout_height="@dimen/attendee_avatar_size"
        android:indeterminate="true"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/root_splash_logo"
        app:layout_constraintStart_toStartOf="@+id/root_splash_logo"
        app:layout_constraintEnd_toEndOf="@+id/root_splash_logo"
        android:layout_marginTop="48dp"
        android:indeterminateTint="?attr/proton_icon_accent"
        android:clickable="false"
        android:focusable="false" />

    <TextView
        android:id="@+id/root_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Text.DefaultSmall"
        android:visibility="gone"
        tools:visibility="visible"
        android:text=""
        android:textColor="@color/text_norm"
        app:layout_constraintTop_toBottomOf="@+id/root_progress_bar"
        app:layout_constraintStart_toStartOf="@+id/root_progress_bar"
        app:layout_constraintEnd_toEndOf="@+id/root_progress_bar"
        android:layout_marginTop="@dimen/spacing_element"
        android:clickable="false"
        android:focusable="false" />

</androidx.constraintlayout.widget.ConstraintLayout>
