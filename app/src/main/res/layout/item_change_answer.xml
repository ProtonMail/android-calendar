<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal">

    <View
        android:id="@+id/item_change_answer_divider_top"
        style="@style/Separator"
        android:background="@color/separator_norm"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/item_change_answer_attending"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/item_change_answer_button_yes"
        app:layout_constraintHorizontal_weight="4"
        android:text="@string/event_answer_attending"
        android:layout_marginStart="16dp"
        android:gravity="center_vertical"
        style="@style/Text.DefaultSmall.Weak"
        android:layout_weight="1"
        android:textColor="@color/text_weak"/>

    <include
        android:id="@+id/item_change_answer_button_yes"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/item_change_answer_button_maybe"
        app:layout_constraintHorizontal_weight="2"
        layout="@layout/item_change_answer_button" />

    <include
        android:id="@+id/item_change_answer_button_maybe"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/item_change_answer_button_no"
        app:layout_constraintHorizontal_weight="2"
        layout="@layout/item_change_answer_button" />

    <include
        android:id="@+id/item_change_answer_button_no"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="2"
        layout="@layout/item_change_answer_button" />

</androidx.constraintlayout.widget.ConstraintLayout>
