<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="28dp"
    android:layout_marginEnd="@dimen/all_day_item_margin_end"
    android:layout_marginBottom="@dimen/all_day_item_margin_bottom">

    <View
        android:id="@+id/view_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/shape_item_all_day_event_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/view_background_striped_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:cardElevation="0dp"
        android:layout_marginStart="4dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/view_background"
        app:layout_constraintStart_toStartOf="@+id/view_background"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/view_background_striped"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </androidx.cardview.widget.CardView>

    <!-- TODO Make ripple so that it darken the all day item background, currently lighten -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?android:selectableItemBackground"
        app:layout_constraintStart_toStartOf="@+id/view_background"
        app:layout_constraintEnd_toEndOf="@+id/view_background"
        app:layout_constraintTop_toTopOf="@+id/view_background"
        app:layout_constraintBottom_toBottomOf="@+id/view_background"/>

    <TextView
        android:id="@+id/text_title"
        style="@style/Text.Caption.Strong"
        android:textColor="@color/text_on_calendar_color"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toStartOf="@+id/text_title_side"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Klosterstraße 44, 10179 Berlin, Germany"
        />

    <TextView
        android:id="@+id/text_title_side"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:textColor="@color/text_on_calendar_color"
        android:gravity="center_vertical"
        style="@style/Text.Caption.Strong"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="7dp"
        tools:text="(1/2)" />

    <ImageView
        android:id="@+id/decryption_error_icon"
        style="@style/Icon"
        android:visibility="gone"
        android:layout_width="@dimen/default_icon_size"
        android:layout_height="@dimen/default_icon_size"
        app:srcCompat="@drawable/ic_proton_lock_exclamation_filled"
        android:layout_marginStart="7dp"
        android:layout_marginTop="@dimen/spacing_element_small"
        android:layout_marginBottom="@dimen/spacing_element_small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/decryption_error_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/shape_background_decryption_error"
        android:backgroundTint="@color/text_norm"
        android:alpha="0.1"
        app:layout_constraintEnd_toStartOf="@+id/text_title_side"
        app:layout_constraintStart_toEndOf="@+id/decryption_error_icon"
        app:layout_constraintTop_toTopOf="@+id/decryption_error_icon"
        app:layout_constraintBottom_toBottomOf="@+id/decryption_error_icon"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
