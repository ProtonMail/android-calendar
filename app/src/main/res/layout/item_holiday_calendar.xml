<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/item_holiday_calendar_country_flag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:src="@drawable/flag_ch"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_holiday_calendar_country"
        app:layout_constraintBottom_toBottomOf="@+id/item_holiday_calendar_country"/>
    
    <TextView
        android:id="@+id/item_holiday_calendar_country"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/Text.Default"
        tools:text="Switzerland"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintStart_toEndOf="@+id/item_holiday_calendar_country_flag"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <include
        android:id="@+id/item_holiday_calendar_press"
        layout="@layout/view_press_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_holiday_calendar_country"
        app:layout_constraintBottom_toBottomOf="@+id/item_holiday_calendar_country"/>

</androidx.constraintlayout.widget.ConstraintLayout>