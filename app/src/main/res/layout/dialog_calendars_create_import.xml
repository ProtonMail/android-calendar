<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_calendars_create"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/dialog_calendars_create_press"
            layout="@layout/view_press_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/dialog_calendars_create_icon"
            app:srcCompat="@drawable/ic_proton_pencil"
            android:layout_marginStart="16dp"
            style="@style/Icon"
            app:layout_constraintTop_toTopOf="@+id/dialog_calendars_create_title"
            app:layout_constraintBottom_toBottomOf="@+id/dialog_calendars_create_title"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/dialog_calendars_create_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/calendar_form_create_title"
            style="@style/Text.Default"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/spacing_page"
            app:layout_constraintStart_toEndOf="@+id/dialog_calendars_create_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/dialog_calendars_create_bottom_separator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/dialog_calendars_create_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_calendars_holiday_calendar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_calendars_create"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/dialog_calendars_holiday_calendar_press"
            layout="@layout/view_press_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/dialog_calendars_holiday_calendar_icon"
            app:srcCompat="@drawable/ic_proton_calendar_today"
            android:layout_marginStart="16dp"
            style="@style/Icon"
            app:layout_constraintTop_toTopOf="@+id/dialog_calendars_holiday_calendar_title"
            app:layout_constraintBottom_toBottomOf="@+id/dialog_calendars_holiday_calendar_title"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/dialog_calendars_holiday_calendar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/add_holiday_calendar_title"
            style="@style/Text.Default"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/spacing_page"
            app:layout_constraintStart_toEndOf="@+id/dialog_calendars_holiday_calendar_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/dialog_calendars_holiday_calendar_bottom_separator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/dialog_calendars_holiday_calendar_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_calendars_import"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_calendars_holiday_calendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/dialog_calendars_import_press"
            layout="@layout/view_press_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/dialog_calendars_import_icon"
            app:srcCompat="@drawable/ic_download"
            android:layout_marginStart="16dp"
            style="@style/Icon"
            app:layout_constraintTop_toTopOf="@+id/dialog_calendars_import_title"
            app:layout_constraintBottom_toBottomOf="@+id/dialog_calendars_import_title"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/dialog_calendars_import_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/import_from_google_title"
            style="@style/Text.Default"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/spacing_page"
            app:layout_constraintStart_toEndOf="@+id/dialog_calendars_import_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/dialog_calendars_import_bottom_separator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/dialog_calendars_import_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
