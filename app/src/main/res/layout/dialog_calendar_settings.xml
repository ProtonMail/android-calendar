<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/dialog_calendar_settings_calendar_icon"
        app:srcCompat="@drawable/ic_dot"
        tools:tint="@color/purple_base"
        android:layout_marginStart="19dp"
        style="@style/ColoredDot"
        app:layout_constraintTop_toTopOf="@+id/dialog_calendar_settings_calendar_title"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_calendar_settings_calendar_title"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/dialog_calendar_settings_calendar_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Holiday"
        style="@style/Text.Default"
        android:layout_marginStart="23dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/spacing_page"
        app:layout_constraintStart_toEndOf="@+id/dialog_calendar_settings_calendar_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/dialog_calendar_settings_calendar_separator"
        style="@style/Separator"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_settings_calendar_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_calendar_settings_edit"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_settings_calendar_separator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/dialog_calendar_settings_edit_press"
            layout="@layout/view_press_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/dialog_calendar_settings_edit_icon"
            app:srcCompat="@drawable/ic_proton_pencil"
            android:layout_marginStart="16dp"
            style="@style/Icon"
            app:layout_constraintTop_toTopOf="@+id/dialog_calendar_settings_edit_title"
            app:layout_constraintBottom_toBottomOf="@+id/dialog_calendar_settings_edit_title"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/dialog_calendar_settings_edit_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/action_edit"
            style="@style/Text.Default"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/spacing_page"
            app:layout_constraintStart_toEndOf="@+id/dialog_calendar_settings_edit_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/dialog_calendar_settings_edit_bottom_separator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_settings_edit_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_calendar_settings_default"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_settings_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/dialog_calendar_settings_default_press"
            layout="@layout/view_press_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/dialog_calendar_settings_default_icon"
            app:srcCompat="@drawable/ic_proton_calendar_checkmark"
            android:layout_marginStart="16dp"
            style="@style/Icon"
            app:layout_constraintTop_toTopOf="@+id/dialog_calendar_settings_default_title"
            app:layout_constraintBottom_toBottomOf="@+id/dialog_calendar_settings_default_title"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/dialog_calendar_settings_default_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/action_mark_default"
            style="@style/Text.Default"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/spacing_page"
            app:layout_constraintStart_toEndOf="@+id/dialog_calendar_settings_default_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/dialog_calendar_settings_default_bottom_separator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_settings_default_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_calendar_settings_delete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_settings_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/dialog_calendar_settings_delete_press"
            layout="@layout/view_press_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/dialog_calendar_settings_delete_icon"
            app:srcCompat="@drawable/ic_proton_trash"
            android:layout_marginStart="16dp"
            style="@style/Icon"
            app:layout_constraintTop_toTopOf="@+id/dialog_calendar_settings_delete_title"
            app:layout_constraintBottom_toBottomOf="@+id/dialog_calendar_settings_delete_title"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/dialog_calendar_settings_delete_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/action_delete"
            style="@style/Text.Default"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/spacing_page"
            app:layout_constraintStart_toEndOf="@+id/dialog_calendar_settings_delete_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/dialog_calendar_settings_delete_bottom_separator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_settings_delete_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_calendar_settings_recreate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_settings_delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/dialog_calendar_settings_recreate_press"
            layout="@layout/view_press_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/dialog_calendar_settings_recreate_icon"
            app:srcCompat="@drawable/ic_proton_minus_circle"
            android:layout_marginStart="16dp"
            style="@style/Icon"
            app:layout_constraintTop_toTopOf="@+id/dialog_calendar_settings_recreate_title"
            app:layout_constraintBottom_toBottomOf="@+id/dialog_calendar_settings_recreate_title"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/dialog_calendar_settings_recreate_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/action_recreate"
            style="@style/Text.Default"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/spacing_page"
            app:layout_constraintStart_toEndOf="@+id/dialog_calendar_settings_recreate_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/dialog_calendar_settings_recreate_bottom_separator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_settings_recreate_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
