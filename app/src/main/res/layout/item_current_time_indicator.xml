<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/current_time_indicator_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:background="@drawable/shape_circle_large"
        android:backgroundTint="?attr/colorAccent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/divider_height"
        android:background="?attr/colorAccent"
        app:layout_constraintTop_toTopOf="@+id/current_time_indicator_dot"
        app:layout_constraintBottom_toBottomOf="@+id/current_time_indicator_dot"
        app:layout_constraintStart_toEndOf="@+id/current_time_indicator_dot"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
