<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/chip_group_day_of_week_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="@dimen/spacing_page"
            android:layout_marginEnd="@dimen/spacing_page"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:weightSum="7"
            android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    style="@style/DayOfWeekChip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Mon" />

                <com.google.android.material.chip.Chip
                    style="@style/DayOfWeekChip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Mon"/>

                <com.google.android.material.chip.Chip
                    style="@style/DayOfWeekChip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Mon"/>

                <com.google.android.material.chip.Chip
                    style="@style/DayOfWeekChip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Mon"/>

                <com.google.android.material.chip.Chip
                    style="@style/DayOfWeekChip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Mon"/>

                <com.google.android.material.chip.Chip
                    style="@style/DayOfWeekChip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Mon"/>

                <com.google.android.material.chip.Chip
                    style="@style/DayOfWeekChip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Mon"/>

        </LinearLayout>

        <View
            android:id="@+id/chip_group_separator"
            style="@style/Separator"
            android:layout_marginTop="@dimen/spacing_large"
            app:layout_constraintTop_toBottomOf="@+id/chip_group_day_of_week_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
