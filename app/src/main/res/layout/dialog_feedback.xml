<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="16dp">

    <ImageButton
        android:id="@+id/dialog_calendar_feedback_close_icon"
        style="@style/Icon"
        app:srcCompat="@drawable/ic_proton_cross"
        tools:ignore="UseAppTint"
        android:layout_marginStart="19dp"
        android:layout_width="@dimen/action_background_size"
        android:layout_height="@dimen/action_background_size"
        android:background="?android:selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="@+id/dialog_calendar_feedback_header"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_calendar_feedback_header"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/dialog_calendar_feedback_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/dialog_feedback_header"
        style="@style/Text.Default.Strong"
        android:layout_marginStart="23dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/spacing_page"
        app:layout_constraintStart_toEndOf="@+id/dialog_calendar_feedback_close_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/dialog_calendar_settings_calendar_separator"
        style="@style/Separator"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_feedback_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/dialog_calendar_feedback_form_body"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_calendar_settings_calendar_separator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dialog_calendar_feedback_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_feedback_text"
            style="@style/Text.Default"
            android:layout_margin="16dp"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/button_feedback_rating_1"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/shape_feedback_rounded_bg_disabled"
                app:srcCompat="@drawable/feedback_rating_1"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:textSize="28sp"
                app:layout_constraintEnd_toStartOf="@+id/button_feedback_rating_2"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/button_feedback_rating_2"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/shape_feedback_rounded_bg_disabled"
                app:srcCompat="@drawable/feedback_rating_2"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:textSize="28sp"
                app:layout_constraintEnd_toStartOf="@+id/button_feedback_rating_3"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/button_feedback_rating_1"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/button_feedback_rating_3"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/shape_feedback_rounded_bg_disabled"
                app:srcCompat="@drawable/feedback_rating_3"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:textSize="28sp"
                app:layout_constraintEnd_toStartOf="@+id/button_feedback_rating_4"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/button_feedback_rating_2"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/button_feedback_rating_4"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/shape_feedback_rounded_bg_disabled"
                app:srcCompat="@drawable/feedback_rating_4"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:textSize="28sp"
                app:layout_constraintEnd_toStartOf="@+id/button_feedback_rating_5"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/button_feedback_rating_3"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/button_feedback_rating_5"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/shape_feedback_rounded_bg_disabled"
                app:srcCompat="@drawable/feedback_rating_5"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:layout_marginEnd="16dp"
                android:textSize="28sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/button_feedback_rating_4"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                style="@style/Text.Caption.Weak"
                android:layout_width="88dp"
                android:layout_height="wrap_content"
                android:text="@string/dialog_feedback_rating_worst"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="@+id/button_feedback_rating_1"
                app:layout_constraintStart_toStartOf="@+id/button_feedback_rating_1"
                app:layout_constraintTop_toBottomOf="@+id/button_feedback_rating_1" />

            <TextView
                style="@style/Text.Caption.Weak"
                android:layout_width="88dp"
                android:layout_height="wrap_content"
                android:text="@string/dialog_feedback_rating_best"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="@id/button_feedback_rating_5"
                app:layout_constraintStart_toStartOf="@+id/button_feedback_rating_5"
                app:layout_constraintTop_toBottomOf="@id/button_feedback_rating_5"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <me.proton.core.presentation.ui.view.ProtonInput
            android:id="@+id/input_feeedback_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="4"
            android:inputType="textMultiLine"
            android:imeOptions="actionDone"
            android:theme="@style/ProtonTheme.Calendar"
            android:maxLength="500"
            app:actionMode="clear_text"
            android:hint="@string/dialog_feedback_hint"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:visibility="gone"
            tools:visibility="visible"
            />

        <me.proton.core.presentation.ui.view.ProtonProgressButton
            android:id="@+id/button_submit_feedback"
            style="@style/ProtonButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/dialog_feedback_submit"
            android:enabled="false"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
