<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/holiday_calendar_form_country_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/holiday_calendar_form_country_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/holiday_calendar_form_picker_title"
            style="@style/ProtonTextView.InputHeader"
            android:layout_marginEnd="@dimen/spacing_page"
            android:layout_marginTop="24dp"
            android:layout_marginStart="@dimen/spacing_page"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/holiday_calendar_form_country_value_placeholder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/Text.Default.Weak"
            android:text="@string/holiday_calendar_value_placeholder"
            android:background="@drawable/shape_background_input_field"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="48dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/holiday_calendar_form_country_title"/>

        <TextView
            android:id="@+id/holiday_calendar_form_country_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Switzerland"
            style="@style/Text.Default"
            android:background="@drawable/shape_background_input_field"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="44dp"
            android:paddingEnd="48dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/holiday_calendar_form_country_title"/>

        <ImageView
            android:id="@+id/holiday_calendar_form_country_flag"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            tools:src="@drawable/flag_ch"
            android:layout_marginStart="26dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/holiday_calendar_form_country_value"
            app:layout_constraintBottom_toBottomOf="@+id/holiday_calendar_form_country_value"/>

        <View
            android:id="@+id/holiday_calendar_form_country_value_press"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintEnd_toEndOf="@+id/holiday_calendar_form_country_value"
            app:layout_constraintStart_toStartOf="@+id/holiday_calendar_form_country_value"
            app:layout_constraintTop_toTopOf="@+id/holiday_calendar_form_country_value"
            app:layout_constraintBottom_toBottomOf="@+id/holiday_calendar_form_country_value"/>

        <ImageView
            android:id="@+id/holiday_calendar_form_country_search_icon"
            style="@style/Icon.Form"
            app:tint="@color/icon_weak"
            app:srcCompat="@drawable/ic_proton_chevron_down"
            android:layout_marginEnd="32dp"
            app:layout_constraintTop_toTopOf="@id/holiday_calendar_form_country_value"
            app:layout_constraintBottom_toBottomOf="@id/holiday_calendar_form_country_value"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/holiday_calendar_form_country_search_disclaimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/holiday_calendar_time_zone_based"
            android:visibility="gone"
            tools:visibility="visible"
            style="@style/Text.Caption.Weak"
            android:layout_marginTop="@dimen/spacing_page"
            app:layout_constraintTop_toBottomOf="@+id/holiday_calendar_form_country_value"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/holiday_calendar_form_country_value"
            app:layout_constraintEnd_toEndOf="@+id/holiday_calendar_form_country_value"/>

        <TextView
            android:id="@+id/holiday_calendar_form_country_search_error"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="@string/holiday_calendar_already_exists"
            android:visibility="gone"
            style="@style/Text.Caption.Weak"
            android:textColor="@color/notification_error"
            android:layout_marginTop="@dimen/spacing_page"
            app:layout_constraintTop_toBottomOf="@+id/holiday_calendar_form_country_value"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/holiday_calendar_form_country_value"
            app:layout_constraintEnd_toEndOf="@+id/holiday_calendar_form_country_value"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/holiday_calendar_form_input_separator"
        style="@style/Separator"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/holiday_calendar_form_country_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/holiday_calendar_form_language_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/holiday_calendar_form_input_separator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            android:id="@+id/holiday_calendar_form_language_press"
            layout="@layout/view_press_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/holiday_calendar_form_language_separator"/>

        <ImageView
            android:id="@+id/holiday_calendar_form_language_icon"
            style="@style/Icon.Form"
            app:srcCompat="@drawable/ic_proton_language"
            app:layout_constraintTop_toTopOf="@+id/holiday_calendar_form_language"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/holiday_calendar_form_language"
            style="@style/Text.Default"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/default_margin_text_start"
            android:layout_marginTop="@dimen/spacing_page"
            android:layout_marginEnd="@dimen/spacing_page"
            android:text="@string/calendar_form_language"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/holiday_calendar_form_language_value"
            style="@style/Text.DefaultSmall.Weak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="French"
            android:layout_marginBottom="@dimen/default_margin_text_vertical"
            app:layout_constraintTop_toBottomOf="@+id/holiday_calendar_form_language"
            app:layout_constraintStart_toStartOf="@+id/holiday_calendar_form_language"
            app:layout_constraintEnd_toEndOf="@+id/holiday_calendar_form_language"/>

        <View
            android:id="@+id/holiday_calendar_form_language_separator"
            style="@style/Separator"
            android:layout_marginTop="@dimen/spacing_page"
            app:layout_constraintTop_toBottomOf="@+id/holiday_calendar_form_language_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/holiday_calendar_form_color_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/holiday_calendar_form_language_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            android:id="@+id/holiday_calendar_form_color_press"
            layout="@layout/view_press_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/holiday_calendar_form_color_separator"/>

        <ImageView
            android:id="@+id/holiday_calendar_form_color_icon"
            style="@style/ColoredDot"
            app:srcCompat="@drawable/ic_dot"
            app:tint="@color/background_norm"
            android:layout_marginStart="19dp"
            app:layout_constraintBottom_toBottomOf="@+id/holiday_calendar_form_color"
            app:layout_constraintTop_toTopOf="@+id/holiday_calendar_form_color"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/holiday_calendar_form_color"
            style="@style/Text.Default"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/default_margin_text_start"
            android:layout_marginTop="@dimen/spacing_page"
            android:layout_marginEnd="@dimen/spacing_page"
            tools:text="@string/calendar_form_color"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <View
            android:id="@+id/holiday_calendar_form_color_separator"
            style="@style/Separator"
            android:layout_marginTop="@dimen/spacing_page"
            app:layout_constraintTop_toBottomOf="@+id/holiday_calendar_form_color"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/holiday_calendar_form_default_all_day_event_notifications_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/calendar_form_default_all_day_event_notifications"
        style="@style/Text.DefaultSmall.Strong.Brand"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@+id/holiday_calendar_form_color_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/holiday_calendar_form_default_all_day_event_notifications_list"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:layout_marginTop="@dimen/spacing_element_small"
        app:layout_constraintTop_toBottomOf="@+id/holiday_calendar_form_default_all_day_event_notifications_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/holiday_calendar_form_default_all_day_event_notifications_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/holiday_calendar_form_default_all_day_event_notifications_list"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            android:id="@+id/holiday_calendar_form_default_all_day_event_notifications_press"
            layout="@layout/view_press_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/holiday_calendar_form_default_all_day_event_notifications_separator"/>

        <ImageView
            android:id="@+id/holiday_calendar_form_default_all_day_event_notifications_icon"
            style="@style/Icon.Form"
            app:tint="@color/icon_hint"
            app:srcCompat="@drawable/ic_proton_bell"
            app:layout_constraintBottom_toBottomOf="@+id/holiday_calendar_form_default_all_day_event_notifications"
            app:layout_constraintTop_toTopOf="@+id/holiday_calendar_form_default_all_day_event_notifications"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/holiday_calendar_form_default_all_day_event_notifications"
            style="@style/Text.Default"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/default_margin_text_start"
            android:layout_marginEnd="@dimen/spacing_page"
            android:layout_marginTop="@dimen/spacing_page"
            android:textColor="@color/text_hint"
            android:text="@string/event_text_add_alarm"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <View
            android:id="@+id/holiday_calendar_form_default_all_day_event_notifications_separator"
            style="@style/Separator"
            android:visibility="invisible"
            android:layout_marginTop="@dimen/spacing_page"
            app:layout_constraintTop_toBottomOf="@+id/holiday_calendar_form_default_all_day_event_notifications"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
