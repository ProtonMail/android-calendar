<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/dialog_google_auth_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Text.Headline"
        android:text="@string/dialog_google_auth_title"
        android:layout_marginTop="24dp"
        android:layout_marginStart="@dimen/material_dialog_inset_start"
        android:layout_marginEnd="@dimen/material_dialog_inset_end"/>

    <TextView
        android:id="@+id/dialog_google_auth_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Text.DefaultSmall.Weak"
        android:text="@string/dialog_google_auth_description"
        android:paddingBottom="22dp"
        android:layout_marginStart="@dimen/material_dialog_inset_start"
        android:layout_marginEnd="@dimen/material_dialog_inset_end"
        android:layout_marginTop="@dimen/spacing_large"/>

</LinearLayout>
