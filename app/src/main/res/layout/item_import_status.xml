<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/item_import_status_account"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        style="@style/Proton.Text.Default"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/item_import_status_icon"
        tools:text="eric@gmail.com"/>

    <TextView
        android:id="@+id/item_import_status_details"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        style="@style/Proton.Text.Caption.Weak"
        app:layout_constraintTop_toBottomOf="@+id/item_import_status_account"
        app:layout_constraintStart_toStartOf="@+id/item_import_status_account"
        app:layout_constraintEnd_toEndOf="@+id/item_import_status_account"
        tools:text="1010.73 KB • Jul 28, 2021, 6:36 PM"/>

    <ImageView
        android:id="@+id/item_import_status_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_proton_trash"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_marginEnd="8dp"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_import_status_account"
        app:layout_constraintBottom_toBottomOf="@+id/item_import_status_details"/>

    <include
        android:id="@+id/item_import_status_badge"
        layout="@layout/item_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@+id/item_import_status_account"
        app:layout_constraintTop_toBottomOf="@+id/item_import_status_details"/>

    <LinearLayout
        android:id="@+id/item_import_status_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/item_import_status_badge"
        android:background="@drawable/shape_background_square_rounded"
        android:backgroundTint="@color/notification_warning"
        android:visibility="gone"
        tools:visibility="visible"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <TextView
            android:id="@+id/item_import_status_warning_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            style="@style/Proton.Text.DefaultSmall.Medium"
            android:textColor="@color/text_inverted"
            tools:text="Account is disconnected"/>

        <TextView
            android:id="@+id/item_import_status_warning_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            style="@style/Proton.Text.Caption"
            android:textColor="@color/text_inverted"
            tools:text="Please sign in to your Google account again to resume the import."/>

        <TextView
            android:id="@+id/item_import_status_warning_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_import_status_warning_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:backgroundTint="#33FFFFFF"
            android:textColor="@color/text_inverted"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="14dp"
            android:fontFamily="sans-serif-medium"
            tools:text="Reconnect"/>

    </LinearLayout>

    <View
        android:id="@+id/item_import_status_divider"
        style="@style/Separator"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/item_import_status_warning"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
