<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/fragment_import_assistant_scroll_view"
        android:overScrollMode="never"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/fragment_import_assistant_illustration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="24dp"
                tools:visibility="visible"
                android:src="@drawable/ic_import_assistant_illu"/>

            <ImageView
                android:id="@+id/fragment_import_assistant_in_progress_illustration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                tools:visibility="gone"
                android:src="@drawable/ic_import_in_progress_illu"/>

            <LinearLayout
                android:id="@+id/fragment_import_assistant_loader_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/fragment_import_assistant_illustration"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:gravity="center_horizontal"
                android:visibility="gone"
                tools:visibility="gone"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fragment_import_assistant_loader_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Proton.Text.Headline"
                    android:layout_marginTop="16dp"
                    tools:text="@string/import_assistant_gathering_data_loader_title"/>

                <TextView
                    android:id="@+id/fragment_import_assistant_loader_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Proton.Text.DefaultSmall.Weak"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center_horizontal"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="1 of 6 created in adam@proton.me"/>

                <ProgressBar
                    android:id="@+id/fragment_import_assistant_loader"
                    android:layout_width="@dimen/default_icon_size"
                    android:layout_height="@dimen/default_icon_size"
                    android:indeterminate="true"
                    android:layout_gravity="center"
                    android:clickable="false"
                    android:focusable="false"
                    android:layout_marginTop="24dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/fragment_import_assistant_in_progress_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/fragment_import_assistant_in_progress_illustration"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:gravity="center_horizontal"
                android:visibility="gone"
                tools:visibility="gone"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fragment_import_assistant_in_progress_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Proton.Text.Headline"
                    android:layout_marginTop="16dp"
                    android:text="@string/import_assistant_in_progress_title"/>

                <TextView
                    android:id="@+id/fragment_import_assistant_in_progress_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Proton.Text.DefaultSmall.Weak"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="32dp"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center_horizontal"
                    tools:text="Importing data from adam@gmail.com to eric@protonmail.com."/>

                <TextView
                    android:id="@+id/fragment_import_assistant_in_progress_sub_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Proton.Text.DefaultSmall.Weak"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="32dp"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center_horizontal"
                    android:text="@string/import_assistant_in_progress_sub_description"/>

                <me.proton.core.presentation.ui.view.ProtonButton
                    android:id="@+id/fragment_import_assistant_in_progress_redirect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/ProtonButton.Borderless.Text"
                    android:layout_marginTop="16dp"
                    android:text="@string/import_assistant_in_progress_redirect"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/fragment_import_assistant_summary_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/fragment_import_assistant_illustration"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:gravity="center_horizontal"
                android:visibility="gone"
                tools:visibility="visible"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Proton.Text.Headline"
                    android:layout_marginTop="16dp"
                    android:text="@string/import_assistant_summary_title"/>

                <LinearLayout
                    android:id="@+id/fragment_import_assistant_summary_header_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    tools:visibility="visible"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/fragment_import_assistant_summary_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Proton.Text.DefaultSmall.Weak"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center_horizontal"
                        tools:text="Import 6 of 6 calendars from"/>

                    <TextView
                        android:id="@+id/fragment_import_assistant_summary_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Proton.Text.DefaultSmall.Weak"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center_horizontal"
                        tools:text="eric@gmail.com"/>

                    <TextView
                        android:id="@+id/fragment_import_assistant_summary_create_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Proton.Text.DefaultSmall.Weak"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center_horizontal"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="Create 6 new calendars in Proton Calendar."/>

                    <TextView
                        android:id="@+id/fragment_import_assistant_summary_merge_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Proton.Text.DefaultSmall.Weak"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center_horizontal"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="Merge 1 calendar in Proton Calendar."/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fragment_import_assistant_summary_error_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    tools:visibility="visible"
                    android:background="@drawable/shape_background_secondary_rounded"
                    android:backgroundTint="@color/notification_error"
                    android:gravity="start"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/fragment_import_assistant_summary_error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Proton.Text.DefaultSmall.Weak"
                        android:textColor="@color/text_inverted"
                        android:layout_margin="16dp"
                        tools:text="Can’t create new calendars for all imported calendars due to the personal calendar limit.\n • Deselect at least 2 calendars or\n • Merge at least 2 calendars with existing Proton calendars."/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fragment_import_assistant_summary_customize_import_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/ripple_purple_base"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toBottomOf="@+id/fragment_import_assistant_illustration"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Proton.Text.DefaultSmall.Medium"
                        android:layout_marginTop="12dp"
                        android:textColor="?attr/proton_interaction_norm"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center_horizontal"
                        android:text="@string/import_assistant_summary_customize_import"/>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="8dp"
                        android:src="@drawable/ic_proton_chevron_down_filled"
                        app:tint="?attr/proton_icon_accent" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/fragment_import_assistant_summary_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_import_calendar"
                    tools:itemCount="3"
                    android:overScrollMode="never"/>

                <View
                    android:id="@+id/fragment_import_assistant_summary_bottom_margin"
                    style="@style/Separator"
                    android:background="@color/sidebar_separator"
                    android:visibility="invisible"
                    android:layout_marginTop="80dp"
                    app:layout_constraintTop_toBottomOf="@+id/fragment_import_assistant_summary_list"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <me.proton.core.presentation.ui.view.ProtonProgressButton
        android:id="@+id/fragment_import_assistant_import_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible"
        app:initialState="idle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        tools:text="Import 5 calendars"/>

    <me.proton.core.presentation.ui.view.ProtonButton
        android:id="@+id/fragment_import_assistant_close_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/dialog_button_close"/>

</androidx.constraintlayout.widget.ConstraintLayout>
