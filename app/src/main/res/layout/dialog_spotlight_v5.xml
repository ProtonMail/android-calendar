<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/dialog_spotlight_v5_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/welcome_header_calendar" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dialog_spotlight_v5_title"
            style="@style/Proton.Text.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:text="@string/spotlight_v5_dialog_rebranding_title" />

        <TextView
            android:id="@+id/dialog_spotlight_v5_description"
            style="@style/Proton.Text.DefaultSmall.Weak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:text="@string/spotlight_v5_dialog_rebranding_description" />

        <me.proton.core.presentation.ui.view.ProtonButton
            android:id="@+id/dialog_spotlight_v5_got_it_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:text="@string/spotlight_v5_dialog_got_it_button" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:paddingBottom="24dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/ic_logo_background_shape"
                android:elevation="8dp"
                android:layout_marginHorizontal="8dp"
                app:srcCompat="@drawable/ic_logo_mail"/>

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/ic_logo_background_shape"
                android:elevation="8dp"
                android:layout_marginHorizontal="8dp"
                app:srcCompat="@drawable/ic_logo_calendar"/>

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/ic_logo_background_shape"
                android:elevation="8dp"
                android:layout_marginHorizontal="8dp"
                app:srcCompat="@drawable/ic_logo_drive"/>

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/ic_logo_background_shape"
                android:elevation="8dp"
                android:layout_marginHorizontal="8dp"
                app:srcCompat="@drawable/ic_logo_vpn"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
