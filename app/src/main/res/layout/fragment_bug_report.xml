<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/bug_report_title"
            style="@style/Text.Default.Strong"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/bug_report_hint_title"
            android:inputType="textCapSentences"
            android:maxLength="100"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginStart="@dimen/spacing_page"
            android:layout_marginEnd="@dimen/spacing_page"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:nextFocusDown="@id/bug_report_description"
            android:nextFocusForward="@id/bug_report_description"/>

        <View
            android:id="@+id/bug_report_separator"
            style="@style/Separator"
            android:layout_marginTop="@dimen/default_separator_margin_top"
            app:layout_constraintTop_toBottomOf="@+id/bug_report_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <EditText
            android:id="@+id/bug_report_description"
            style="@style/Text.Default"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/bug_report_hint_description"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="1000"
            android:gravity="top"
            android:layout_marginTop="@dimen/default_separator_margin_top"
            android:layout_marginBottom="@dimen/spacing_page"
            app:layout_constraintTop_toBottomOf="@+id/bug_report_separator"
            app:layout_constraintStart_toStartOf="@+id/bug_report_title"
            app:layout_constraintEnd_toEndOf="@+id/bug_report_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
